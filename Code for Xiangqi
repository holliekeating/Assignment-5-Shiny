library(shiny)
library(shinydashboard)
library(dplyr)
library(ggplot2)
library(DT)
library(scales)

dig_raw <- read.csv("DIG.csv")

dig <- dig_raw %>%
  mutate(
    treatment   = factor(TRTMT, levels = c(0, 1),
                         labels = c("Placebo", "Digoxin")),
    sex         = factor(SEX,  levels = c(1, 2),
                         labels = c("Male", "Female")),
    race        = factor(RACE, levels = c(1, 2),
                         labels = c("White", "Nonwhite")),
    age         = AGE,
    bmi         = BMI,
    ejf_per     = EJF_PER,
    klevel      = KLEVEL,
    creatinine  = CREAT,
    sbp         = SYSBP,
    dbp         = DIABP,
    death       = DEATH,
    deathday    = DEATHDAY,
    hosp        = HOSP,
    hospdays    = HOSPDAYS,
    nhosp       = NHOSP
  )

validate_data <- function(d) {
  validate(need(nrow(d) > 0, "当前筛选条件下没有数据，请调整筛选条件。"))
}

ui <- dashboardPage(
  dashboardHeader(title = "DIG Trial Explorer"),
  
  dashboardSidebar(
    sidebarMenu(
      menuItem("About",      tabName = "about",    icon = icon("info-circle")),
      menuItem("Baseline",   tabName = "baseline", icon = icon("chart-bar")),
      menuItem("Outcomes",   tabName = "clinical", icon = icon("heartbeat")),
      ## ===== Tabs 4–6: Xiangqi's modules =====
      menuItem("Variable explorer", tabName = "relations", icon = icon("project-diagram")),
      menuItem("Patient browser",   tabName = "patients",  icon = icon("users")),
      menuItem("Docs",              tabName = "docs",      icon = icon("book"))
      ## =======================================
    )
  ),
dashboardBody(
    tabItems(       

                  ## -------- Tab 4: Relations  ----------------------
      tabItem(
        tabName = "relations",
        fluidRow(
          box(
            width = 3, status = "primary", solidHeader = TRUE,
            title = "Controls (by Xiangqi)",
            
            # X 变量选择器
            selectInput(
              inputId = "r_x",
              label   = "X variable",
              choices = c("Age"                = "age",
                          "BMI"                = "bmi",
                          "Ejection fraction"  = "ejf_per",
                          "Potassium (KLEVEL)" = "klevel",
                          "Creatinine"         = "creatinine",
                          "Systolic BP"        = "sbp",
                          "Diastolic BP"       = "dbp")
            ),
            
            # Y 变量选择器
            selectInput(
              inputId = "r_y",
              label   = "Y variable",
              choices = c("Ejection fraction"  = "ejf_per",
                          "BMI"                = "bmi",
                          "Potassium (KLEVEL)" = "klevel",
                          "Creatinine"         = "creatinine",
                          "Systolic BP"        = "sbp",
                          "Diastolic BP"       = "dbp")
            ),
            
            # 颜色/分组选择器
            selectInput(
              inputId = "r_col",
              label   = "Colour / Group by",
              choices = c("None"      = "none",
                          "Treatment" = "treatment",
                          "Sex"       = "sex",
                          "Race"      = "race")
            ),
            
            # 平滑线勾选框
            checkboxInput(
              inputId = "r_smooth",
              label   = "Add linear trend line",
              value   = TRUE
            )
          ),
          
          box(
            width = 9, status = "primary", solidHeader = TRUE,
            title = "Scatterplot & Correlation",
            
            plotOutput("plot_rel"),
            br(),
            strong("Pearson correlation: "),
            textOutput("txt_cor")
          )
        )
      ),
      
                n  ## -------- Tab 5: Patients  ----------------------
      tabItem(
        tabName = "patients",
        fluidRow(
          box(
            width = 3, status = "primary", solidHeader = TRUE,
            title = "Filters (by Xiangqi)",
            
            # 治疗筛选
            selectInput(
              inputId = "p_trt",
              label   = "Treatment",
              choices = c("All", levels(dig$treatment))
            ),
            
            # 性别筛选
            selectInput(
              inputId = "p_sex",
              label   = "Sex",
              choices = c("All", levels(dig$sex))
            ),
            
            # 年龄范围
            sliderInput(
              inputId = "p_age",
              label   = "Age range",
              min     = floor(min(dig$age, na.rm = TRUE)),
              max     = ceiling(max(dig$age, na.rm = TRUE)),
              value   = c(40, 80),
              step    = 1
            ),
            
            # 生存/死亡/住院状态
            selectInput(
              inputId = "p_status",
              label   = "Status",
              choices = c("All",
                          "Died",
                          "Alive",
                          "Hospitalized",
                          "Never hospitalized")
            )
          ),
          box(
            width = 9, status = "primary", solidHeader = TRUE,
            title = "Patient-level data",
            DTOutput("tbl_patients")
          )
        )
      ),
               
