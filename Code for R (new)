    age         = AGE,
    bmi         = BMI,
    ejf_per     = EJF_PER,
    klevel      = KLEVEL,
    creatinine  = CREAT,
    sbp         = SYSBP,
    dbp         = DIABP,
    death       = DEATH,
    deathday    = DEATHDAY,
    hosp        = HOSP,
    hospdays    = HOSPDAYS,
    nhosp       = NHOSP
  )

