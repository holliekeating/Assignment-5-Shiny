## ======== 1. 数据读取与预处理 ========

dig_raw <- read.csv("DIG-1.csv")

dig <- dig_raw %>%
  mutate(
    treatment   = factor(TRTMT, levels = c(0, 1),
                         labels = c("Placebo", "Digoxin")),
    sex         = factor(SEX,  levels = c(1, 2),
                         labels = c("Male", "Female")),
    race        = factor(RACE, levels = c(1, 2),
                         labels = c("White", "Nonwhite")),
    age         = AGE,
    bmi         = BMI,
    ejf_per     = EJF_PER,
    klevel      = KLEVEL,
    creatinine  = CREAT,
    sbp         = SYSBP,
    dbp         = DIABP,
    death       = DEATH,
    deathday    = DEATHDAY,
    hosp        = HOSP,
    hospdays    = HOSPDAYS,
    nhosp       = NHOSP
  )

validate_data <- function(d) {
  validate(need(nrow(d) > 0, "当前筛选条件下没有数据，请调整筛选条件。"))
}

