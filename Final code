    d <- d %>% filter(age >= input$p_age[1], age <= input$p_age[2])
    
    if (input$p_status == "Died") {
      d <- d %>% filter(death == 1)
    } else if (input$p_status == "Alive") {
      d <- d %>% filter(death == 0)
    } else if (input$p_status == "Hospitalized") {
