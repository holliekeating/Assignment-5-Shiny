             title = paste("Histogram of", var, "by treatment"))
    } else {
      ggplot(d, aes_string(x = "treatment", y = var, fill = "treatment")) +
        geom_boxplot(alpha = 0.7) +
        labs(x = "Treatment", y = var,
             title = paste("Boxplot of", var, "by treatment"))
    }
